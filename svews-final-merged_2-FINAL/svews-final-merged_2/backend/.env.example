# --- Core (original) ---
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/svews
JWT_SECRET=change_this_to_a_long_random_string

# --- App base URL — used to build PayHere/webhook callback URLs ---
# For local testing, PayHere's webhook needs a PUBLICLY reachable URL, so
# use an ngrok (or similar) tunnel URL here, not localhost. See README.
APP_BASE_URL=http://localhost:4000

# --- AI Chatbot ("Ask SVEWS") ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- PayHere Sandbox (payments, subscriptions, fees) ---
# Sign up free at https://sandbox.payhere.lk to get these.
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_MERCHANT_SECRET=your_sandbox_merchant_secret
PAYHERE_MODE=sandbox

# --- Currency conversion (USD prices shown, PayHere charges in LKR) ---
USD_TO_LKR_RATE=300

# --- Registration fees (one-time, paid before account creation) ---
REGISTRATION_FEE_USER_USD=20
REGISTRATION_FEE_SUPPLIER_USD=25

# --- Monthly subscription (User -> Supplier/Teacher/Course, 10/90 split) ---
SUBSCRIPTION_MONTHLY_USD=20

# --- Monthly platform fee (Supplier -> Warehouse, flat, not revenue-shared) ---
PLATFORM_FEE_MONTHLY_USD=10
